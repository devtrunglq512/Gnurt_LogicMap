# =============================================================================
#  Unity .gitattributes  (Unity 6 / 6000.x)
#  - Chuẩn hoá line ending cho file text
#  - File YAML của Unity: không đổi line ending, dùng Unity Smart Merge
#  - File binary lớn: lưu bằng Git LFS (cần chạy `git lfs install` một lần)
#  Dòng phía dưới sẽ ghi đè dòng phía trên nếu cùng khớp một file.
# =============================================================================

# ---- Mặc định: git tự nhận diện text và lưu LF trong repo ----
* text=auto

# ---- Code & text ----
*.cs             text diff=csharp
*.shader         text
*.shadergraph    text
*.shadersubgraph text
*.cginc          text
*.hlsl           text
*.glsl           text
*.compute        text
*.raytrace       text
*.uss            text
*.uxml           text
*.tss            text
*.asmdef         text
*.asmref         text
*.inputactions   text
*.json           text
*.xml            text
*.yml            text
*.yaml           text
*.md             text
*.txt            text
*.csv            text
*.html           text
*.css            text
*.js             text
*.svg            text
*.gradle         text
*.pro            text
*.properties     text
*.pom            text
*.java           text
*.kt             text
*.h              text
*.c              text
*.cpp            text
*.m              text
*.mm             text
*.swift          text
*.plist          text
*.rsp            text

# Script chạy theo nền tảng
*.sh             text eol=lf
*.bat            text eol=crlf
*.cmd            text eol=crlf
*.ps1            text eol=crlf
*.sln            text eol=crlf
*.csproj         text eol=crlf

# ---- Unity YAML (Force Text serialization) ----
# -text : giữ nguyên line ending Unity ghi ra (an toàn cả khi file .asset là binary)
# diff  : vẫn hiển thị diff dạng text
# merge=unityyamlmerge : dùng Unity Smart Merge nếu đã cấu hình trong git config
*.meta                 -text merge=unityyamlmerge diff
*.unity                -text merge=unityyamlmerge diff
*.prefab               -text merge=unityyamlmerge diff
*.asset                -text merge=unityyamlmerge diff
*.mat                  -text merge=unityyamlmerge diff
*.anim                 -text merge=unityyamlmerge diff
*.controller           -text merge=unityyamlmerge diff
*.overrideController   -text merge=unityyamlmerge diff
*.mask                 -text merge=unityyamlmerge diff
*.playable             -text merge=unityyamlmerge diff
*.signal               -text merge=unityyamlmerge diff
*.physicMaterial       -text merge=unityyamlmerge diff
*.physicsMaterial      -text merge=unityyamlmerge diff
*.physicsMaterial2D    -text merge=unityyamlmerge diff
*.mixer                -text merge=unityyamlmerge diff
*.preset               -text merge=unityyamlmerge diff
*.lighting             -text merge=unityyamlmerge diff
*.giparams             -text merge=unityyamlmerge diff
*.renderTexture        -text merge=unityyamlmerge diff
*.spriteatlas          -text merge=unityyamlmerge diff
*.spriteatlasv2        -text merge=unityyamlmerge diff
*.terrainlayer         -text merge=unityyamlmerge diff
*.brush                -text merge=unityyamlmerge diff
*.flare                -text merge=unityyamlmerge diff
*.fontsettings         -text merge=unityyamlmerge diff
*.guiskin              -text merge=unityyamlmerge diff
*.shadervariants       -text merge=unityyamlmerge diff
*.scenetemplate        -text merge=unityyamlmerge diff
*.cubemap              -text merge=unityyamlmerge diff
*.unityproj            -text merge=unityyamlmerge diff

